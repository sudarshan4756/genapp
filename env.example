import React, { useState, useEffect } from "react";
import { 
  Terminal, ShieldCheck, Activity, CreditCard, LogOut, Cpu, Layout, 
  Menu, X, Laptop, User, Lock, ExternalLink 
} from "lucide-react";
import LandingPage from "./components/LandingPage";
import AuthModal from "./components/AuthModal";
import Workspace from "./components/Workspace";
import Observability from "./components/Observability";
import SecurityPortal from "./components/SecurityPortal";
import BillingManager from "./components/BillingManager";
import { UserSession } from "./types";

export default function App() {
  const [session, setSession] = useState<UserSession | null>(null);
  const [isAuthOpen, setIsAuthOpen] = useState(false);
  const [currentView, setCurrentView] = useState<"workspace" | "telemetry" | "security" | "billing">("workspace");
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);

  // Default credentials mapping
  const handleAuthSuccess = (newSession: UserSession) => {
    setSession(newSession);
  };

  const handleLogout = () => {
    setSession(null);
    setCurrentView("workspace");
  };

  const enterSandboxDirectly = () => {
    // Grant quick access so they can preview the platform instantly
    const guestSession: UserSession = {
      email: "sudarshaniitp4756@gmail.com", // Main default user account
      role: "ADMIN",
      token: "standard-guest-rotating-jwt",
      isActive: true
    };
    setSession(guestSession);
  };

  return (
    <div className="bg-slate-950 min-h-screen text-slate-100 font-sans flex flex-col justify-between selection:bg-indigo-500/30">
      {/* Unauthenticated Landing Experience */}
      {!session ? (
        <LandingPage 
          onEnterSandbox={enterSandboxDirectly} 
          onOpenAuth={() => setIsAuthOpen(true)} 
        />
      ) : (
        /* Authenticated Dashboard Core Console */
        <div className="flex-1 flex flex-col md:flex-row relative min-h-screen">
          {/* LEFT PERSISTENT SIDEBAR PANEL */}
          <aside className="w-full md:w-64 bg-slate-900 border-r border-slate-900 shrink-0 md:sticky md:top-0 md:h-screen flex flex-col justify-between z-30">
            {/* Sidebar Top Banner */}
            <div>
              <div className="p-5 border-b border-slate-900 flex justify-between items-center">
                <div className="flex items-center gap-2.5">
                  <div className="p-2.5 bg-gradient-to-br from-indigo-500 to-purple-500 rounded-xl text-white font-extrabold text-sm shadow-md">
                    FA
                  </div>
                  <div>
                    <h3 className="font-extrabold text-white text-sm tracking-tight">ForgeAI</h3>
                    <p className="text-[10px] text-indigo-400 font-bold uppercase tracking-wider">Console panel</p>
                  </div>
                </div>
                <button
                  onClick={() => setMobileMenuOpen(!mobileMenuOpen)}
                  className="p-1 px-2 md:hidden text-slate-400 hover:text-white border border-slate-800 rounded-lg hover:bg-slate-800"
                >
                  {mobileMenuOpen ? <X className="w-4 h-4" /> : <Menu className="w-4 h-4" />}
                </button>
              </div>

              {/* Sidebar Navigation Options */}
              <nav className={`p-4 space-y-1.5 ${mobileMenuOpen ? "block" : "hidden md:block"}`}>
                <button
                  id="nav-workspace-btn"
                  onClick={() => { setCurrentView("workspace"); setMobileMenuOpen(false); }}
                  className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-bold tracking-wide transition ${
                    currentView === "workspace" 
                      ? "bg-slate-850/80 text-white" 
                      : "text-slate-400 hover:text-slate-200 hover:bg-slate-950/20"
                  }`}
                >
                  <Laptop className="w-4 h-4 text-indigo-400" />
                  <span>Workspace Studio</span>
                </button>

                <button
                  id="nav-observability-btn"
                  onClick={() => { setCurrentView("telemetry"); setMobileMenuOpen(false); }}
                  className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-bold tracking-wide transition ${
                    currentView === "telemetry" 
                      ? "bg-slate-850/80 text-white" 
                      : "text-slate-400 hover:text-slate-200 hover:bg-slate-950/20"
                  }`}
                >
                  <Activity className="w-4 h-4 text-emerald-400" />
                  <span>Observability Core</span>
                </button>

                <button
                  id="nav-security-btn"
                  onClick={() => { setCurrentView("security"); setMobileMenuOpen(false); }}
                  className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-bold tracking-wide transition ${
                    currentView === "security" 
                      ? "bg-slate-850/80 text-white" 
                      : "text-slate-400 hover:text-slate-200 hover:bg-slate-950/20"
                  }`}
                >
                  <ShieldCheck className="w-4 h-4 text-purple-400" />
                  <span>Enterprise Shield</span>
                </button>

                <button
                  id="nav-billing-btn"
                  onClick={() => { setCurrentView("billing"); setMobileMenuOpen(false); }}
                  className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-bold tracking-wide transition ${
                    currentView === "billing" 
                      ? "bg-slate-850/80 text-white" 
                      : "text-slate-400 hover:text-slate-200 hover:bg-slate-950/20"
                  }`}
                >
                  <CreditCard className="w-4 h-4 text-amber-500" />
                  <span>Billing & Tiers</span>
                </button>
              </nav>
            </div>

            {/* Sidebar Bottom logged user card */}
            <div className={`p-4 border-t border-slate-900 ${mobileMenuOpen ? "block" : "hidden md:block"}`}>
              <div className="bg-slate-950/40 p-3 rounded-xl border border-slate-900 mb-3 text-left">
                <div className="flex items-center gap-2 mb-1.5">
                  <User className="w-3.5 h-3.5 text-indigo-400" />
                  <span className="text-[10px] uppercase font-bold tracking-wider text-slate-500">Logon tenant</span>
                </div>
                <div className="text-xs font-bold text-white truncate">{session.email}</div>
                <div className="text-[10px] text-slate-500 mt-0.5">Role: {session.role}</div>
              </div>

              <button
                id="logout-btn"
                onClick={handleLogout}
                className="w-full flex items-center gap-2.5 px-3 py-1.5 rounded-lg text-xs font-bold text-slate-400 hover:text-rose-400 hover:bg-rose-500/5 transition cursor-pointer"
              >
                <LogOut className="w-4 h-4" />
                <span>Log Out Session</span>
              </button>
            </div>
          </aside>

          {/* MAIN DYNAMIC CONTENT SWITCHBOARD */}
          <main className="flex-1 bg-slate-950 min-h-screen flex flex-col justify-between overflow-x-hidden">
            {currentView === "workspace" && (
              <Workspace 
                onBackToLanding={handleLogout} 
                userEmail={session.email} 
              />
            )}
            {currentView === "telemetry" && <Observability />}
            {currentView === "security" && <SecurityPortal />}
            {currentView === "billing" && <BillingManager />}
          </main>
        </div>
      )}

      {/* POP-UP AUTH SECURE MODAL */}
      <AuthModal 
        isOpen={isAuthOpen} 
        onClose={() => setIsAuthOpen(false)} 
        onSuccess={handleAuthSuccess} 
      />
    </div>
  );
}
